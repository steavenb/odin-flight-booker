<h1>All Bookings</h1>

<table>
  <thead>
    <tr>
      <th>Booking ID</th>
      <th>Flight</th>
      <th>Passengers</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @bookings.each do |booking| %>
      <tr>
        <td><%= booking.id %></td>
        <td>
          <%= booking.flight.departure_airport.airport_code %> to
          <%= booking.flight.arrival_airport.airport_code %>
          (<%= booking.flight.start.strftime("%Y-%m-%d %H:%M") %>)
        </td>
        <td>
          <ul>
            <% booking.passengers.each do |passenger| %>
              <li><%= passenger.name %> (<%= passenger.email %>)</li>
            <% end %>
          </ul>
        </td>
        <td>
          <%= link_to 'Show', booking_path(booking) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
