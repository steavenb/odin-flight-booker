<h1>Booking Details</h1>

<h3>Flight Information</h3>
<p>
  <strong>Departure Airport:</strong>
  <%= @booking.flight.departure_airport.airport_code %> - <%= @booking.flight.departure_airport.name %>
</p>
<p>
  <strong>Arrival Airport:</strong>
  <%= @booking.flight.arrival_airport.airport_code %> - <%= @booking.flight.arrival_airport.name %>
</p>
<p>
  <strong>Departure Time:</strong>
  <%= @booking.flight.start.strftime("%Y-%m-%d %H:%M") %>
</p>
<p>
  <strong>Duration:</strong>
  <%= @booking.flight.duration %> minutes
</p>

<h3>Passengers</h3>
<ul>
  <% @booking.passengers.each do |passenger| %>
    <li>
      <strong>Name:</strong> <%= passenger.name %><br>
      <strong>Email:</strong> <%= passenger.email %>
    </li>
  <% end %>
</ul>

<%= link_to 'Back to Bookings', bookings_path %>
