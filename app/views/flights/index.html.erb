<h1>Air Sentia</h1>

<%= form_with url: flights_path, method: :get do |form| %>
  <%= form.label :departure_airport_id, "Departure Airport" %>
  <%= form.select :departure_airport_id, @airports.map { |airport| [airport.airport_code, airport.id] }, { include_blank: "Select Departure Airport", selected: params[:departure_airport_id] } %>
  <%= form.label :arrival_airport_id, "Arrival Airport" %>
  <%= form.select :arrival_airport_id, @airports.map { |airport| [airport.airport_code, airport.id] }, { include_blank: "Select Arrival Airport", selected: params[:arrival_airport_id] } %>
  <%= form.label :number_of_passengers, "Number of Passengers" %>
  <%= form.number_field :number_of_passengers, min: 1, max: 4, value: params[:number_of_passengers] || 1 %>
  <%= form.label :start_date, "Start Time" %>
  <%= form.select :start_date, @available_flight_dates, { include_blank: "Select Start Date", selected: params[:start_date] } %>
  <%= form.submit "Search Flights" %>
<% end %>

<% if @flight_results.present? %>
<h2>Flight Results</h2>
<%=form_with url: "/bookings/new", method: :get do |booking_form| %>
  <table>
    <thead>
      <tr>
        <th>Departure Airport</th>
        <th>Arrival Airport</th>
        <th>Departure Time</th>
        <th>Duration (min)</th>
      </tr>
    </thead>
    <tbody>
        <% if @flight_results.empty? %>
          <tr>
            <td colspan="4">No flights found</td>
          </tr>
        <% else %>
          <% @flight_results.each do |flight| %>
            <tr>
              <td><%= flight.departure_airport.airport_code %> - <%= flight.departure_airport.name %></td>
              <td><%= flight.arrival_airport.airport_code %> - <%= flight.arrival_airport.name %></td>
              <td><%= flight.start.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= flight.duration %></td>
              <td><%= booking_form.hidden_field :number_of_passengers, value: params[:number_of_passengers] %></td>
              <td><%= booking_form.radio_button :flight_id, flight.id %></td>
            </tr>
          <% end %>
        <% end %>
    </tbody>
  </table>
  <%= booking_form.submit "Add booking details for selected Flight" %>
<% end %>
<% end %>